<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_badge_premium.xml
    Background drawable untuk badge status akun di OwnerDashboard.
    Dipakai oleh txtStatusAkun di fragment_owner_dashboard.xml.
    Warnanya diubah secara programatik dari Java sesuai status akun.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#ECFDF5" />

    <corners android:radius="20dp" />

    <stroke
        android:width="1dp"
        android:color="#A7F3D0" />

</shape>
