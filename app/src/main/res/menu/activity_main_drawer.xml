            android:title="@string/menu_tutup_kasir" />

        <item
            android:id="@+id/nav_like"
            android:icon="@drawable/ic_16_px_idle_rating"
            android:title="@string/menu_rating" />

        <item
            android:id="@+id/nav_logout"
            android:icon="@drawable/ic_16_px_idle_logout"
            android:title="@string/menu_logout" />

