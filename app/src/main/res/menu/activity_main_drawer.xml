        <item
            android:id="@+id/nav_report"
            android:title="@string/menu_laporan" />

        <item
            android:id="@+id/nav_sales_report"
            android:title="@string/menu_laporan_penjualan" />

        <item
            android:id="@+id/nav_sales_detail"
            android:title="@string/menu_detail_laporan" />

        <item
            android:id="@+id/nav_setting"
            android:icon="@drawable/ic_16_px_idle_pengaturan"
            android:title="@string/menu_pengaturan" />

        <item
            android:id="@+id/nav_open"
