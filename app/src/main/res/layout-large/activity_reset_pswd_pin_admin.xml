<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ResetPswdPinAdmin">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/white"
        android:elevation="5dp"
        android:gravity="center_vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingEnd="15dp">

            <TextView
                android:id="@+id/tvLabelToolbar"
                style="@style/TitleMulishH4Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:textColor="@color/primary_navy" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/ll_password"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="24dp"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etPasswordLama"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pwd_lama"
                android:enabled="false"
                android:inputType="textPassword"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etPasswordBaru"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pwd_baru"
                android:inputType="textPassword"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUlangiPwdbaru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etUlangiPasswordBaru"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ulangi_pwd_baru"
                android:inputType="textPassword"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btSimpanPwd"
                style="@style/TitleMulishH5Normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="35dp"
                android:background="@drawable/theme_button_simpan"
                android:text="@string/simpan"
                android:textAllCaps="false"
                android:textColor="@color/white_bg" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_pin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="24dp"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etPinLama"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pin_lama"
                android:enabled="false"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etPinBaru"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pin_baru"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUlangiPinBaru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etUlangiPinBaru"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ulangi_pin_baru"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btSimpanPin"
                style="@style/TitleMulishH5Normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="35dp"
                android:background="@drawable/theme_button_simpan"
                android:text="@string/simpan"
                android:textAllCaps="false"
                android:textColor="@color/white_bg" />

        </RelativeLayout>
    </LinearLayout>

</LinearLayout>