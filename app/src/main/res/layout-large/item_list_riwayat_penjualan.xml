<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_marginBottom="10dp"
        android:id="@+id/ll_riwayat_penjualan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_bgwhite_border_ungu"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:padding="10dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tvLayanan"
                    style="@style/LabelDmS1Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:background="@drawable/bg_item_nama_dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/ojekonlen"
                    android:textAlignment="center"
                    android:textColor="@color/white_bg" />

                <TextView
                    android:id="@+id/tvInvoice"
                    style="@style/BodyDmP1Regular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:textAlignment="textEnd"
                    android:textColor="@color/primary_navy" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNamaCust"
                style="@style/BodyDmP1Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/muhammadiqbal"
                android:textColor="@color/primary_navy" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvQty"
                    style="@style/LabelDmS1Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/jumlah"
                    android:textColor="@color/black_80" />

                <TextView
                    android:id="@+id/tvTotalTransaksi"
                    style="@style/BodyDmP1Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total"
                    android:textAlignment="textEnd"
                    android:textColor="@color/primary_navy" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>