<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".printer.PengaturanDetailOutputPrinter">

    <TextView
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:id="@+id/namaprinter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:padding="5dp"
        android:text="@string/nama_device"
        android:textColor="@color/black_100" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#C0C0C0" />

    <TextView
        android:id="@+id/alamatprinter"
        style="@style/BodyDmP1Regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:padding="4dp"
        android:text="BT:081f9325" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#C0C0C0" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CCCCCC">

        <TextView
            style="@style/TitleDmH5Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:padding="7dp"
            android:text="CETAK STRUK"
            android:textColor="@color/black_100" />

        <Switch
            android:id="@+id/switchstruk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="5dp"
            android:padding="7dp" />


    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C0C0C0" />

    <RelativeLayout
        android:id="@+id/laystruk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="7dp"
        android:padding="5dp">

        <TextView
            style="@style/TitleDmH5Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/jumlah" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/minIcon"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="false"
                android:focusable="true"
                android:src="@drawable/ic_24_px_minus_square" />

            <TextView
                android:id="@+id/tvTotalCetakStruk"
                style="@style/BodyMulishP1Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@color/gray_6"
                android:padding="10dp"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@color/black_100" />

            <ImageView
                android:id="@+id/plusIcon"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="false"
                android:focusable="true"
                android:src="@drawable/ic_24_px_plus_square" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#C0C0C0" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#C0C0C0" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CCCCCC">


        <TextView
            style="@style/TitleDmH5Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:padding="7dp"
            android:text="LEBAR STRUK"
            android:textColor="@color/black_100" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C0C0C0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="7dp"
        android:orientation="vertical"
        android:padding="5dp">

        <RadioGroup
            android:id="@+id/rgrub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false">

            <RadioButton
                android:id="@+id/rbdefault"
                style="@style/TitleDmH5Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                />


        </RadioGroup>


    </LinearLayout>

    <Button
        android:id="@+id/btSimpan"
        style="@style/TitleMulishH5Normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/theme_button_simpan"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/simpan"
        android:textAllCaps="false"
        android:textColor="@color/white_bg" />

</LinearLayout>