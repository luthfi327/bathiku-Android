<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="40dp"
    android:orientation="vertical">

    <TextView
        style="@style/TitleMulishH4Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/konfirmasi"
        android:textAlignment="center"
        android:textColor="@color/primary_navy" />

    <TextView
        android:id="@+id/tvMessages"
        style="@style/BodyDmP1Regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/kunci_layar_t"
        android:textAlignment="center"
        android:textColor="@color/primary_navy" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBatal"
            style="@style/TitleMulishH5Bold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/batal"
            android:textAlignment="center"
            android:textColor="@color/colorPrimary" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btHapus"
            style="@style/TitleMulishH5Normal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/theme_button_tutupkasir"
            android:text="@string/hapus"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />
    </LinearLayout>

</LinearLayout>