<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp"
    android:orientation="vertical">

    <TextView
        style="@style/TitleMulishH4Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/peringatan"
        android:textAlignment="center"
        android:textColor="@color/primary_navy" />

    <TextView
        style="@style/BodyDmP1Medium13sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/apakah_anda_yakin_menghapus_data_ini"
        android:textAlignment="center"
        android:textColor="@color/primary_navy" />

    <TextView
        android:id="@+id/tvObject"
        style="@style/BodyDmP1Medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textAlignment="center"
        android:textColor="@color/black_100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBatal"
            style="@style/BodyDmP1Bold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/batal"
            android:textAlignment="center"
            android:textColor="@color/colorPrimary" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btIya"
            style="@style/BodyDmP1Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/theme_button_tutupkasir"
            android:text="@string/hapus"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />
    </LinearLayout>

</LinearLayout>