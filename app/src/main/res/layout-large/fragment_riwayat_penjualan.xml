<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/ll_Kosong"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/il_180_px_daftar_pesanan" />

        <TextView
            style="@style/TitleDmH5Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/daftar_riwayat_penj_kosong"
            android:textAlignment="center"
            android:textColor="@color/primary_navy" />

        <TextView
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/riwayat_penjualan_kosong"
            android:textAlignment="center"
            android:textColor="@color/primary_navy" />
    </LinearLayout>

    <EditText
        android:id="@+id/etRiwayatPenjualan"
        style="@style/BodyDmP1Medium"
        android:inputType="textCapWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/search_theme_edit_text"
        android:drawableEnd="@drawable/ic_16_px_search"
        android:hint="@string/car_nama_pelanggan_atau_invoice"
        android:padding="15dp" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRiwayatPenjualan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>