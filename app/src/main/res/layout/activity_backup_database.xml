<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Backup Database" />

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="6dp"
            android:layout_margin="16dp"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TitleMulishH3ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backup Database"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"
                    android:textColor="@color/colorPrimary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDownload"
                    android:background="@drawable/theme_button_simpan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Download Database (Simpan di Device)"
                    android:padding="12dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white_bg"
                    android:layout_marginBottom="16dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUpload"
                    android:background="@drawable/theme_button_simpan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload ke Server API"
                    android:textAllCaps="false"
                    android:textColor="@color/white_bg"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/BodyDmP1Regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Belum ada tindakan"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>