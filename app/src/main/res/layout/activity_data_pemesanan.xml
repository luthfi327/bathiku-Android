<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".DataPemesananAct"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/white"
        android:elevation="5dp"
        app:layout_collapseMode="pin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingEnd="15dp">

            <TextView
                style="@style/TitleMulishH5Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Data Pemesanan"
                android:textColor="@color/primary_navy" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etNamaPelanggan"
            android:inputType="textCapWords"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nama_pelanggan_ops"
            android:textColor="@color/colorPrimary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content">

        <EditText
            android:inputType="textCapWords"
            android:id="@+id/etIdMemberPelanggan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID Member Pelanggan (Opsional)"
            android:textColor="@color/black" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.chivorn.smartmaterialspinner.SmartMaterialSpinner
        android:id="@+id/SpinJenisKedatangan"
        style="@style/BodyDmP1Regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:smsp_floatingLabelColor="@color/black_80"
        app:smsp_floatingLabelText="@string/kategori"
        app:smsp_hint="@string/jenis_kedatangan"
        app:smsp_hintColor="@color/black_80"
        app:smsp_itemColor="@color/primary_navy"
        app:smsp_itemListColor="@color/primary_navy"
        app:smsp_itemListHintColor="#FFFFFF"
        app:smsp_multilineError="false"
        app:smsp_selectedItemListColor="@color/accent_yellow" />

    <TextView
        style="@style/LabelDmS1Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/black_90"
        android:layout_marginTop="9dp"
        android:text="Tipe Diskon"/>

    <Spinner
        android:id="@+id/spTipeDiskon"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:inputType="number"
            android:id="@+id/etDiskon"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/diskon_ops"
            android:textColor="@color/colorPrimary" />
    </com.google.android.material.textfield.TextInputLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btResetData"
            style="@style/TitleMulishH5Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btSimpan"
            android:visibility="gone"
            android:layout_marginBottom="20dp"
            android:background="@drawable/theme_button_tutupkasir"
            android:text="Reset Data Pelanggan"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btSimpan"
            style="@style/TitleMulishH5Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="25dp"
            android:background="@drawable/theme_button_simpan"
            android:text="@string/simpan"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />
    </RelativeLayout>

    </LinearLayout>

    </LinearLayout>

</LinearLayout>