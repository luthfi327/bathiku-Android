<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="14dp"
    tools:context=".ui.laporan.LaporanFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="4dp">

            <View
                android:id="@+id/tabIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/tab_indicator_oval"
                android:layout_margin="2dp" />

            <LinearLayout
                android:id="@+id/customTabContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="3"
                android:background="@android:color/transparent">

                <TextView
                    android:id="@+id/tabPenjualan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Penjualan"
                    android:textColor="@color/primary_navy"
                    android:background="@android:color/transparent"
                    android:textStyle="bold"
                    android:layout_margin="2dp" />

                <TextView
                    android:id="@+id/tabKas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Kas"
                    android:textColor="@color/primary_navy"
                    android:background="@android:color/transparent"
                    android:textStyle="bold"
                    android:layout_margin="2dp" />

                <TextView
                    android:id="@+id/tabStok"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Stok"
                    android:textColor="@color/primary_navy"
                    android:background="@android:color/transparent"
                    android:textStyle="bold"
                    android:layout_margin="2dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSelectToko"
        android:padding="5dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:hint=" Pilih Toko (Untuk Owner)"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/spinnerMultiToko"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/footerText"
            style="@style/LabelMulishS1Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© Bathiku by PyramidSoft"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />
    </LinearLayout>
</LinearLayout>