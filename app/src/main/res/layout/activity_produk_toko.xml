<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ProdukTokoActivity"
    android:fitsSystemWindows="true">

    <!-- ✅ TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Produk"
        app:titleTextColor="@android:color/black" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ProdukTokoActivity">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etNamaProduk"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nama_produk"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/SpinJK"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_16_px_active_chevron_down"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="10dp"
            android:text="@string/kategori"
            android:textColor="@color/black_80" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="4dp"
            android:background="@color/black_80" />
    </LinearLayout>

    <com.chivorn.smartmaterialspinner.SmartMaterialSpinner
        android:id="@+id/spinKategori"
        style="@style/BodyDmP1Regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:smsp_floatingLabelColor="@color/black_80"
        app:smsp_floatingLabelText="@string/kategori"
        app:smsp_hint="@string/kategori"
        app:smsp_hintColor="@color/black_80"
        app:smsp_itemColor="@color/primary_navy"
        app:smsp_itemListColor="@color/primary_navy"
        app:smsp_itemListHintColor="#FFFFFF"
        app:smsp_multilineError="false"
        app:smsp_selectedItemListColor="@color/accent_yellow" />

    <LinearLayout
        android:id="@+id/ll_kategori_skrg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:visibility="gone">

        <TextView
            style="@style/LabelMulishS1Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/kategori_skrg" />

        <TextView
            android:id="@+id/tvKategori"
            style="@style/LabelMulishS1Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:textColor="@color/accent_green" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:id="@+id/rel_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="SpeakableTextPresentCheck">

            <ImageView
                android:tag="kosong"
                android:id="@+id/ivProduk"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/rounded_imgview_upload_pict" />

            <ImageView
                android:id="@+id/ic_icon_camera"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerInParent="true"
                android:src="@drawable/camera_logo" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvUploadProduk"
            style="@style/LabelDmS1Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="25dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="@string/upload_foto_produk"
            android:textColor="@color/secondary_purple"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUploadUlangProduk"
            style="@style/LabelDmS1Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="25dp"
            android:background="@drawable/rounded_refresh_image"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_16_px_active_refresh"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:padding="10dp"
            android:text="@string/upload_foto_produk_baru"
            android:textColor="@color/secondary_purple" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/etSKU"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sku"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="15dp">

        <TextView
            style="@style/TitleMulishH5Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gunakan Stok"
            android:textColor="@color/primary_navy"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switchStok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etStok"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stok"
            android:inputType="numberDecimal"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etHrgAwal"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/harga_awal"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etHrgJual"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/harga_jual"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etHrgDiskon"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Harga Diskon (Opsional)"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false">

        <EditText
            android:id="@+id/etLaba"
            style="@style/BodyDmP1Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Laba"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="5dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/beri_harga_diskon" />

        <Switch
            android:id="@+id/switchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btEdit"
            style="@style/TitleMulishH5Normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="35dp"
            android:background="@drawable/theme_button_simpan"
            android:text="@string/update"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btSimpan"
            style="@style/TitleMulishH5Normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="35dp"
            android:background="@drawable/theme_button_simpan"
            android:text="@string/simpan"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />

    </RelativeLayout>
</LinearLayout>
</ScrollView>
</LinearLayout>