<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.bukatutup.BukaTutupFragment">

    <TextView
        android:id="@+id/tvNamaUser"
        style="@style/TitleMulishH2Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/nama_user"
        android:textAlignment="center"
        android:textColor="@color/black_100" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvNamaUser"
        android:scrollbars="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llInfoMasuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:background="@drawable/bg_textviewbukatutup"
                android:orientation="vertical"
                android:padding="15dp">

                <LinearLayout
                    android:id="@+id/ll_bukatoko"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/LabelDmS1Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/buka"
                        android:textAlignment="textEnd"
                        android:textColor="@color/accent_green" />

                    <TextView
                        android:id="@+id/tvDateBukaToko"
                        style="@style/LabelDmS1Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:paddingStart="5dp"
                        android:textColor="@color/black_100" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_tutuptoko_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/LabelDmS1Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/tutup"
                        android:textAlignment="textEnd"
                        android:textColor="@color/accent_red" />

                    <TextView
                        android:id="@+id/tvDateTutupToko"
                        style="@style/LabelDmS1Medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:paddingStart="5dp"
                        android:textColor="@color/black_100" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_kas_awal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llInfoMasuk"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/modal_awal"
                        android:textColor="@color/primary_navy" />

                    <TextView
                        android:id="@+id/tvModalAwal"
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_100" />
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/dotted_line"
                    android:layerType="software" />
            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/ll_tutuptoko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_kas_awal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp">

                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/penjualan"
                        android:textColor="@color/black_80" />

                    <TextView
                        android:id="@+id/tvPemasukanKasir"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_80" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp">

                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/kas_keluar"
                        android:textColor="@color/black_80" />

                    <TextView
                        android:id="@+id/tvPengeluaranKasir"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_80" />
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/dotted_line"
                    android:layerType="software" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvJenisPembayaran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/dotted_line"
                    android:layerType="software" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/penerimaan_sistem"
                        android:textColor="@color/primary_navy" />

                    <TextView
                        android:id="@+id/tvPenerimaanSistem"
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_100" />
                </LinearLayout>

                <TextView
                    style="@style/LabelDmS13spRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/penerimaan_sistem_pen"
                    android:textColor="@color/black_80" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/penerimaan_aktual"
                        android:textColor="@color/primary_navy" />

                    <TextView
                        android:id="@+id/tvPenerimaanAktual"
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/tunai"
                        android:textColor="@color/black_80" />

                    <TextView
                        android:id="@+id/tvTunai"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_80" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/nontunai"
                        android:textColor="@color/black_80" />

                    <TextView
                        android:id="@+id/tvNonTunai"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/black_80" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyDmP1Bold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/selisih"
                        android:textColor="@color/primary_navy" />

                    <TextView
                        android:id="@+id/tvSelisih"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textColor="@color/secondary_purple" />
                </LinearLayout>

                <TextView
                    style="@style/LabelDmS13spRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/selisih_penj"
                    android:textColor="@color/black_80" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_tutuptoko"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btBukaKasir"
                    style="@style/TitleMulishH5Normal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/theme_button_simpan"
                    android:text="@string/buka_kasir"
                    android:textAllCaps="false"
                    android:textColor="@color/white_bg" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btTutupKasir"
                    style="@style/TitleMulishH5Normal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/theme_button_tutupkasir"
                    android:text="@string/tutup_kasir"
                    android:textAllCaps="false"
                    android:textColor="@color/white_bg" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btKasKeluar"
                style="@style/TitleMulishH5Normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llButton"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/theme_button_warning"
                android:text="@string/kas_keluar"
                android:textAllCaps="false"
                android:textColor="@color/white_bg" />

        </RelativeLayout>

    </ScrollView>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:padding="12dp"
        android:text="© Bathiku by PyramidSoft"
        android:textColor="#555555"
        android:textSize="12sp" />

</RelativeLayout>