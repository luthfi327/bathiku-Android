<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".PressPinAct">

    <TextView
        style="@style/TitleMulishH4Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/masukkan_pin_anda"
        android:textAlignment="center"
        android:textColor="@color/primary_navy" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/vbd_01"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/badge_kuning_pin" />

        <View
            android:id="@+id/vbd_02"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/badge_kuning_pin" />

        <View
            android:id="@+id/vbd_03"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/badge_kuning_pin" />

        <View
            android:id="@+id/vbd_04"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/badge_kuning_pin" />

        <View
            android:id="@+id/vbd_05"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/badge_kuning_pin" />

        <View
            android:id="@+id/vbd_06"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/badge_kuning_pin" />

    </LinearLayout>

    <EditText
        android:focusable="true"
        android:id="@+id/tvPreview"
        style="@style/TitleMulishH4Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:inputType="numberPassword"
        android:text="123456"
        android:textAlignment="center"
        android:textColor="@color/accent_yellow"
        android:textColorHint="@color/black_50"
        android:textSize="50sp" />

    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_1"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />

            <TextView
                android:id="@+id/tv_2"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="2"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />

            <TextView
                android:id="@+id/tv_3"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="3"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_4"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="4"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />

            <TextView
                android:id="@+id/tv_5"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="5"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />

            <TextView
                android:id="@+id/tv_6"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="6"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_7"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="7"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />

            <TextView
                android:id="@+id/tv_8"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="8"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />

            <TextView
                android:id="@+id/tv_9"
                style="@style/TitleMulishH2Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="9"
                android:textAlignment="center"
                android:textColor="@color/primary_navy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="C"
                android:textAlignment="center"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="0"
                android:textAlignment="center"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/gray_backspace_icon"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="50dp"
                android:textAlignment="center"
                android:textColor="@color/black"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btKonfirmasi"
        style="@style/BodyDmP1Medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="74dp"
        android:background="@drawable/theme_button_simpan"
        android:text="@string/konfirmasi"
        android:textAllCaps="false"
        android:textColor="@color/white_bg" />

</LinearLayout>