<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OnlineLoginPageActivity"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"/>

<ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/il_180_px_welcome_screen" />

    <TextView
        android:id="@+id/tvWelcome"
        style="@style/TitleMulishH2Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="160dp"
        android:text="@string/selamat_datang_di"
        android:textColor="@color/black_100" />

    <ImageView
        android:id="@+id/IvLogo"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_below="@id/tvWelcome"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/logo" />

    <LinearLayout
        android:id="@+id/loginForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/IvLogo"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical">

        <TextView
            style="@style/TitleDmH5Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/silahkanmasuk"
            android:textColor="@color/primary_navy" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <EditText
                android:id="@+id/etUsernameAdmin"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/masukkan_username"
                android:inputType="textCapWords"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etPasswordAdmin"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/masukkan_password"
                android:inputType="textPassword"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary_navy">

            <EditText
                android:id="@+id/etPin"
                style="@style/BodyDmP1Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvLupaSandi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Lupa Sandi?"
            android:textColor="@color/primary_navy"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/loginForm"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etEmailReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan Email Terdaftar"
                android:inputType="textEmailAddress"
                android:textColor="@color/primary_navy"/>
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btKirimReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/theme_button_simpan"
            android:text="Kirim"
            android:textAllCaps="false"
            android:textColor="@color/white_bg"/>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btLanjutkan"
        style="@style/BodyDmP1Medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="74dp"
        android:background="@drawable/theme_button_simpan"
        android:text="@string/lanjutkan"
        android:textAllCaps="false"
        android:textColor="@color/white_bg" />

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/layout_buat_akun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/BodyDmP1Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="4dp"
            android:text="@string/belum_punya_akun"
            android:textAlignment="textEnd"
            android:textColor="@color/black_80" />

        <TextView
            android:id="@+id/tvBuatAkun"
            style="@style/BodyDmP1Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/buat_akun"
            android:textColor="@color/black_100" />
    </LinearLayout>

</RelativeLayout>
