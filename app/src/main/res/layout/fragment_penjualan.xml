<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context=".ui.laporan.fragment.PenjualanFragment">

<!-- ====== CONTENT ====== -->
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:context=".ui.laporan.fragment.PenjualanFragment">

            <TextView
                style="@style/LabelDmS13spRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                android:soundEffectsEnabled="true"
                android:text="@string/pilih_tgl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTgl1"
                    style="@style/BodyDmP1Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_bgwhite_border_ungu"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:text="@string/pilih_tgl1">
                </TextView>

                <TextView
                    style="@style/BodyDmP1Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvTgl2"
                    style="@style/BodyDmP1Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_bgwhite_border_ungu"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:text="@string/pilih_tgl2">
                </TextView>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- KIRI : Penjualan + Laba -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Total Penjualan -->
                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_penjualan" />

                    <TextView
                        android:id="@+id/tvTotalPenjualan"
                        style="@style/BodyDmP1Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <!-- Total Laba -->
                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Laba" />

                    <TextView
                        android:id="@+id/tvTotalLaba"
                        style="@style/BodyDmP1Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- KANAN : Total Transaksi -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical|end"
                    android:padding="14dp">

                    <TextView
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_transaksi"
                        android:textAlignment="textEnd" />

                    <TextView
                        android:id="@+id/tvTotalTransaksi"
                        style="@style/BodyDmP1Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="textEnd" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMetodePembayaran"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:text="@string/metode_pembayaran" />

                    <ImageView
                        android:id="@+id/img_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMetodePembayaran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProdukTerlaris"
                        style="@style/LabelDmS13spRegular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:text="@string/produk_terlaris" />

                    <ImageView
                        android:id="@+id/img_arrow2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProdukTerlaris"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Download PDF -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDownloadPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_margin="5dp"
            android:contentDescription="Download PDF"
            app:backgroundTint="@color/gray_6"
            app:srcCompat="@drawable/ic_pdf" />

        <!-- Download Excel -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDownloadExcel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_margin="5dp"
            android:contentDescription="Download Excel"
            app:backgroundTint="@color/gray_6"
            app:srcCompat="@drawable/ic_csv" />

        <!-- Download Menu -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:contentDescription="Download"
            app:backgroundTint="@color/gray_6"
            app:srcCompat="@drawable/ic_download" />

        <!-- Print Thermal -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPrintThermal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:contentDescription="Print Thermal"
            app:backgroundTint="@color/gray_6"
            app:srcCompat="@drawable/gray_print_logo" />

    </LinearLayout>

</FrameLayout>