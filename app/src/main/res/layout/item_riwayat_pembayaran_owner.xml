<?xml version="1.0" encoding="utf-8"?>
<!--
    item_riwayat_pembayaran_owner.xml
    Layout satu baris item di RecyclerView riwayat pembayaran owner.

    Dipakai oleh RiwayatPembayaranAdapter.
    Menampilkan: tanggal, nominal, durasi, badge status, kode transaksi,
    dan tanggal aktif baru (hanya untuk status PAID).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E5E7EB"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Baris 1: Tanggal + Badge Status ────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Ikon kalender -->
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="📅"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTanggalBayar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01 Jan 2026, 10:00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggal Transaksi"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF"/>

                </LinearLayout>

                <!-- Badge Status -->
                <TextView
                    android:id="@+id/tvStatusBayar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAID"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/badge_background"
                    android:textColor="#166534"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- ── Divider ─────────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginBottom="10dp"/>

            <!-- ── Baris 2: Nominal + Durasi ──────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Nominal -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nominal"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvNominalBayar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 49.000"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#38405A"/>

                </LinearLayout>

                <!-- Durasi -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Durasi"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvDurasiBayar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 bulan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#38405A"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ── Kode Transaksi ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F9FAFB"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kode: "
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"/>

                <TextView
                    android:id="@+id/tvKodeTransaksi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="INV-XXXXX"
                    android:textSize="11sp"
                    android:textColor="#6B7280"
                    android:ellipsize="end"
                    android:maxLines="1"/>

            </LinearLayout>

            <!-- ── Divider Exp Baru (hanya muncul jika PAID) ─────────────── -->
            <View
                android:id="@+id/dividerExpBaru"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"/>

            <!-- ── Aktif sampai (hanya muncul jika PAID) ──────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ "
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvExpBaruBayar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktif s/d 01 Jan 2027"
                    android:textSize="12sp"
                    android:textColor="#166534"
                    android:textStyle="bold"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>