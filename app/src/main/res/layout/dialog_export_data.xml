<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Pilih Data yang Akan Diekspor:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- PILIH SEMUA DATA -->
        <CheckBox
            android:id="@+id/cbPilihSemuaData"
            android:text="Pilih Semua Data"
            android:textStyle="italic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- CHECKBOX BIASA → geser -->
        <CheckBox
            android:id="@+id/cbJenisKedatangan"
            android:text="Jenis Kedatangan"
            android:layout_marginLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/cbKategori"
            android:text="Kategori"
            android:layout_marginLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/cbProduk"
            android:text="Produk"
            android:layout_marginLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


        <!-- TOKO TUJUAN -->
        <TextView
            android:text="Pilih Toko Sumber:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spTokoTujuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <!-- TOKO PENERIMA -->
        <TextView
            android:text="Toko Penerima:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/llTokoPenerima"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnExportNow"
            android:text="Ekspor Sekarang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>
