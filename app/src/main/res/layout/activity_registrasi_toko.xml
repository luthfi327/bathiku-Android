<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    tools:context=".RegistrasiToko"
    android:fitsSystemWindows="true">

<androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingEnd="15dp">
        <TextView
            style="@style/TitleMulishH4Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_weight="1"
            android:text="@string/registrasi_toko"
            android:textColor="@color/primary_navy"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textSize="20sp" />
        <TextView
            style="@style/TabMulish14pxRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/langkah1"
            android:textColor="@color/secondary_purple"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textSize="18sp" />
    </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Bagian kiri -->
                <LinearLayout
                    android:id="@+id/leftSection"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical|start"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        style="@style/TitleMulishH2Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat"
                        android:textColor="@color/black_100"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TitleMulishH2Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datang Di"
                        android:textColor="@color/black_100"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/IvLogo"
                        android:layout_width="170dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/logo" />
                </LinearLayout>

                <!-- Bagian kanan -->
                <LinearLayout
                    android:id="@+id/rightSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:src="@drawable/il_180_px_welcome_screen" />
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/tvKeterangan"
                style="@style/TitleDmH5Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/IvKeranjang"

                android:text="@string/buatlah_toko"
                android:textColor="@color/primary_navy" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilKodeToko"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/etKodeToko"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:hint="Kode Toko" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ProgressBar
                        android:id="@+id/ProgressBar"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@id/tilKodeToko"
                        android:layout_alignRight="@id/tilKodeToko"
                        android:layout_alignBottom="@id/tilKodeToko"
                        android:layout_marginEnd="10dp" />
                </RelativeLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etNamaToko"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/BodyDmP1Regular"
                        android:hint="@string/nama_toko"
                        android:inputType="textCapWords"
                        android:importantForAutofill="no"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilJenisUsaha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <AutoCompleteTextView
                        android:id="@+id/etJenisUsaha"
                        style="@style/BodyDmP1Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Jenis Usaha"
                        android:inputType="textCapWords"
                        android:minHeight="48dp"
                        android:paddingStart="15dp"
                        android:importantForAutofill="no"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <AutoCompleteTextView
                        android:id="@+id/etProvinsi"
                        style="@style/BodyDmP1Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/provinsi"
                        android:inputType="textCapWords"
                        android:importantForAutofill="no"
                        android:minHeight="48dp"
                        android:paddingStart="15dp"
                        android:autofillHints="" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <AutoCompleteTextView
                        android:id="@+id/etKota"
                        style="@style/BodyDmP1Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/kota"
                        android:inputType="textCapWords"
                        android:importantForAutofill="no"
                        android:minHeight="48dp"
                        android:paddingStart="15dp"
                        android:autofillHints="" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAlamat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etAlamat"
                        style="@style/BodyDmP1Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Alamat Toko (Opsional)"
                        android:inputType="textMultiLine"
                        android:minLines="1"
                        android:maxLines="4"
                        android:importantForAutofill="no"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvInfoAlamat"
                    style="@style/LabelDmS1Regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alamat hanya digunakan untuk ditampilkan di struk."
                    android:textColor="@color/black_90"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <EditText
                            android:id="@+id/etEmail"
                            style="@style/BodyDmP1Regular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/email"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKirimOtp"
                        style="@style/LabelMulishS1Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Kirim OTP"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:background="@drawable/theme_button_simpan"
                        android:textColor="@color/white_bg"/>
                </LinearLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etNoHp"
                        style="@style/BodyDmP1Regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/no_hp_toko"
                        android:inputType="phone"
                        android:importantForAutofill="no"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>


                <LinearLayout
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:id="@+id/rel_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        tools:ignore="SpeakableTextPresentCheck">

                        <ImageView
                            android:id="@+id/ivUploadLogo"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/rounded_imgview_upload_pict"
                            android:rotation="0"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/ic_icon_camera"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/camera_logo" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvUploadLogo"
                        style="@style/LabelDmS1Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="25dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/upload_logo"
                        android:textColor="@color/secondary_purple" />

                    <TextView
                        android:id="@+id/tvUploadUlangFotoLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="25dp"
                        android:background="@drawable/rounded_refresh_image"
                        android:clickable="true"
                        android:drawableEnd="@drawable/refresh_logo"
                        android:drawablePadding="10dp"
                        android:focusable="true"
                        android:padding="10dp"
                        android:text="Upload Ulang Foto Logo"
                        android:textColor="#7373bc"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivLogoStruk"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/rounded_imgview"
                            android:rotation="0"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/ic_icon_camera2"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/img_icon" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvLogoStruk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="25dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="Upload Logo Struk"
                        android:textColor="#7373bc" />

                    <TextView
                        android:id="@+id/tvUploadUlangLogoStruk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="25dp"
                        android:background="@drawable/rounded_refresh_image"
                        android:clickable="true"
                        android:drawableEnd="@drawable/refresh_logo"
                        android:drawablePadding="10dp"
                        android:focusable="true"
                        android:padding="10dp"
                        android:text="Upload Ulang Logo Struk"
                        android:textColor="#7373bc"
                        android:visibility="gone" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btSimpan"
                        style="@style/TitleMulishH5Normal"
                        android:textColor="@color/white_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/theme_button_simpan"
                        android:text="@string/lanjut_ke_daftar_p"
                        android:textAllCaps="false"
                        android:textStyle="bold"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btNext"
                    style="@style/TitleMulishH5Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/theme_button_simpan"
                    android:text="@string/next"
                    android:textAllCaps="false"
                    android:textColor="@color/white_bg"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/tvKeteranganNext"
                    style="@style/LabelDmS1Regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="24dp"
                    android:textAlignment="center"
                    android:textColor="@color/accent_green" />
            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</LinearLayout>