<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ListProdukActivity"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/white"
        android:elevation="5dp"
        android:gravity="center_vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingEnd="15dp">

            <TextView
                style="@style/TitleMulishH4Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/daftar_barang"
                android:textColor="@color/primary_navy" />

            <!-- Tombol Tambah -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btExport"
                style="@style/TabMulish14pxRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="12dp"
                android:background="@drawable/theme_toolbar_btn_adduser"
                android:drawableStart="@drawable/baseline_import_export_24"
                android:drawablePadding="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Export"
                android:textAllCaps="false"
                android:textColor="@color/white_bg" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btTambahDaftarBrg"
                style="@style/TabMulish14pxRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/btExport"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                android:background="@drawable/theme_toolbar_btn_adduser"
                android:drawableStart="@drawable/ic_baseline_add_24"
                android:drawablePadding="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/tambah"
                android:textAllCaps="false"
                android:textColor="@color/white_bg" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/ll_list_barang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/ll_ada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <EditText
                android:id="@+id/etPencarianProduk"
                style="@style/BodyDmP1Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:inputType="textCapWords"
                android:background="@drawable/search_theme_edit_text"
                android:drawableEnd="@drawable/ic_16_px_search"
                android:hint="@string/cari_barang"
                android:padding="15dp" />

            <TextView
                android:id="@+id/btSearchKategori"
                style="@style/BodyDmP1Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="0.5"
                android:background="@drawable/kategori_theme_button"
                android:clickable="true"
                android:drawableStart="@drawable/ic_16_px_kategori"
                android:focusable="true"
                android:padding="15dp"
                android:text="@string/kategori"
                android:textAlignment="center" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_Kosong"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            style="@style/TitleDmH5Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/belum_ada_barang"
            android:textAlignment="center"
            android:textColor="@color/primary_navy" />

        <TextView
            style="@style/BodyDmP1Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ket_barang_kosong"
            android:textAlignment="center"
            android:textColor="@color/primary_navy" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btTambahBrgKosong"
            style="@style/TabMulish14pxRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:background="@drawable/theme_toolbar_btn_adduser"
            android:drawableStart="@drawable/ic_baseline_add_24"
            android:drawablePadding="5dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/tambah_barang"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btTambahTemplate"
            style="@style/TabMulish14pxRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/theme_toolbar_btn_adduser"
            android:drawableStart="@drawable/ic_baseline_format_list_bulleted_24"
            android:drawablePadding="5dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Tambah Template"
            android:textAllCaps="false"
            android:textColor="@color/white_bg" />

    </LinearLayout>

</LinearLayout>